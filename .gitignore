# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environments / conda
venv/
.venv/
env/

# Trained model weights (too large, regenerated by training — never commit)
weights/*
!weights/.gitkeep

# Dataset files (never commit the actual images/CSVs — see data/README.md for how to get them)
data/*
!data/README.md

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.code-workspace

# Logs / experiment outputs
*.log
runs/
outputs/